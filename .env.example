# --- توکن ربات تلگرام (مستقل از ربات اصلی) ---
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# --- مالکان ربات (آی‌دی‌های عددی با کاما جدا شوند) ---
OWNER_IDS=123456789,987654321

# --- گروه هدف برای مدیریت مقام‌ها و اعضا ---
TARGET_CHAT_ID=-1002641478967

# --- کانال یا گروه لاگ عملیات مدیریتی (اختیاری) ---
LOG_CHAT_ID=

# --- اتصال به دیتابیس PostgreSQL (در محیط توسعه/تست: sqlite+aiosqlite:///rankbot.db) ---
DATABASE_URL=postgresql+asyncpg://rankbot_user:rankbot_password@127.0.0.1:5432/rankbot

# --- کلید مشترک HMAC برای امضای وب‌هوک و API بین دو ربات (حداقل ۳۲ بایت امن) ---
RANK_SYNC_SECRET=change_this_to_a_secure_random_32_bytes_hex_string

# --- وب‌سرور داخلی ربات مقام (برای دریافت رویداد season-ended) ---
RANK_BOT_API_HOST=127.0.0.1
RANK_BOT_API_PORT=8091

# --- آدرس API وب‌سرور داخلی ربات اصلی (برای دریافت روستر بازیکنان /roster) ---
MAIN_BOT_API_URL=http://127.0.0.1:8090

# --- منبع داده‌ی بازیکنان: http یا db (خواندن فقط‌خواندنی مستقیم از دیتابیس ربات اصلی) ---
ROSTER_SOURCE=http

# --- ماژول‌های فعال (خالی = تمام ماژول‌ها) ---
ENABLED_MODULES=

# --- خروج خودکار از گروه‌هایی غیر از گروه هدف ---
AUTO_LEAVE_UNAUTHORIZED_GROUPS=true

# --- محدودیت زمانی ضد اسپم برای دستورهای اعضا (ثانیه) ---
MEMBER_CMD_COOLDOWN_SEC=20

# --- منطقه‌ی زمانی ---
TZ=Asia/Tehran
